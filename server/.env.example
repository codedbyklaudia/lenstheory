# Copy this file to .env and fill in real values. .env is git-ignored; this example file is not.

# Neon dashboard -> your project -> Connect -> connection string (keep ?sslmode=require on the end)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me

# The address people use to open the site (the FRONTEND). Locally that is Vite's dev server.
BETTER_AUTH_URL=http://localhost:5173

# Websites allowed to sign in (comma-separated). Usually the same as BETTER_AUTH_URL.
CLIENT_ORIGIN=http://localhost:5173

# Email addresses allowed into the admin dashboard at /admin (comma-separated).
ADMIN_EMAILS=you@example.com

# ---- Optional: replying to enquiries by email from the dashboard ----
# Resend (resend.com) -> API Keys. Without these, the Reply button explains that email is not set up.
RESEND_API_KEY=
# Who replies come from. Until you verify your own domain in Resend, use onboarding@resend.dev
# (it can only send to the email you signed up to Resend with, which is fine for testing).
EMAIL_FROM=Lens Theory <onboarding@resend.dev>

# ---- Optional: uploading photos from the dashboard ----
# Vercel -> your project -> Storage -> Create -> Blob. Vercel adds this to the deployed project
# by itself; copy it here for local development. Without it you can still paste image URLs.
BLOB_READ_WRITE_TOKEN=
