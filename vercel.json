{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        { "source": "/admin", "destination": "/index.html" },
        { "source": "/account", "destination": "/index.html" },
        { "source": "/order/(.*)", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
